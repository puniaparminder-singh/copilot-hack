# Availity (developer.availity.com -> create an app, subscribe to Coverages)
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_BASE_URL=https://api.availity.com/availity/v1
AVAILITY_SCOPE=hipaa
# POST or GET - confirm in the Coverages 1.0.0 reference for your app
AVAILITY_COVERAGES_METHOD=POST
# Demo plan only: canned response scenario
AVAILITY_MOCK_SCENARIO_ID=

# Practice / rendering provider
PROVIDER_NPI=
PROVIDER_LAST_NAME=
PROVIDER_TAX_ID=
# eCW insurance name = Availity payer ID, separated by ";"
# Look up each payer ID in Availity's payer list; do not assume EDI IDs match.
PAYER_MAP=Aetna=<availity-payer-id>;Cigna=<availity-payer-id>

# Claude (needs a BAA with Anthropic before sending PHI)
ANTHROPIC_API_KEY=

# eCW FHIR (only if not using --csv)
ECW_FHIR_BASE_URL=
ECW_FHIR_TOKEN_URL=
ECW_FHIR_CLIENT_ID=
ECW_FHIR_PRIVATE_KEY_PATH=
ECW_FHIR_KEY_ID=
