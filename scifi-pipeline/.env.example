OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=

# Canva Connect (OAuth integration from https://www.canva.com/developers/)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Canva refresh tokens are single-use; the pipeline stores the rotated one in output/.canva_token.json
CANVA_REFRESH_TOKEN=

# YouTube: OAuth "Desktop app" client from Google Cloud Console with YouTube Data API v3 enabled.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=output/.youtube_token.json
